{
  "name": "ryugazaki-archive",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /ryugazaki-design-systems/ && node -e \"require('fs').copyFileSync('dist/ryugazaki-archive/browser/index.html','dist/ryugazaki-archive/browser/404.html')\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:systems": "node scripts/check-systems.mjs",
    "sync:themes": "node scripts/sync-themes.mjs",
    "build:pen": "node scripts/pen/glass-aurora-pen.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.31",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
